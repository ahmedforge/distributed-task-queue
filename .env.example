# Docker Compose Environment
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=task_queue_db
REDIS_HOST=redis
REDIS_PORT=6379

# Local Development Fallbacks (if running uvicorn/saq directly outside Docker)
# POSTGRES_SERVER=localhost
# REDIS_HOST=localhost
STORAGE_DIR=data/jobs
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=50

# Retry windows grow exponentially; SAQ applies random jitter within each window.
RETRY_BASE_DELAY=2
RETRY_MAX_DELAY=60

# Optional monitoring stack: initial Grafana admin password (set before first start).
GRAFANA_ADMIN_PASSWORD=admin

# Dashboard host port (change if a local Vite server uses 3000)
FRONTEND_PORT=3000

# Optional docker-compose.storage.yml (local demo credentials only)
MINIO_ROOT_USER=dtq-local
MINIO_ROOT_PASSWORD=dtq-local-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Direct Python execution: STORAGE_BACKEND=s3 and S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=dtq-jobs, S3_REGION=us-east-1, S3_ACCESS_KEY / S3_SECRET_KEY
